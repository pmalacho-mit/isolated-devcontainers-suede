 }
diff --git a/src/store.ts b/src/store.ts
index f99c13e..81060ad 100644
--- a/src/store.ts
+++ b/src/store.ts
@@ -2,18 +2,21 @@ export interface Todo {
   id: number;
   title: string;
   done: boolean;
+  due?: Date;
 }
 
 export class Store {
   private items: Todo[] = [];
+  private nextId = 1;
 
-  add(title: string): Todo {
-    const todo = { id: this.items.length + 1, title, done: false };
+  add(title: string, due?: Date): Todo {
+    const todo: Todo = { id: this.nextId++, title: title.trim(), done: false, due };
     this.items.push(todo);
     return todo;
   }
 
-  remaining(): number {
-    return this.items.filter((t) => !t.done).length;
+  remaining(now = new Date()): { open: number; overdue: number } {
+    const open = this.items.filter((t) => !t.done);
+    return { open: open.length, overdue: open.filter((t) => t.due !== undefined && t.due < now).length };
   }
 }

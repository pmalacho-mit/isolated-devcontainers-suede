# Copy to .env and edit. Then: chmod 600 .env
#
# VSCODE_TOKEN is deliberately ABSENT, and this file must never carry a value
# for it. It gates 127.0.0.1:$VSCODE_PORT, which can read and write every
# project in /workspaces, so a token that ships in a public repo is no token at
# all -- and a .env.example gets copied wholesale far more often than it gets
# read. `cli.sh up` refuses to start without one, which is the behaviour you
# want here: mint your own, in a real shell, where the substitution runs.
#
#   echo "VSCODE_TOKEN=$(openssl rand -hex 24)" >> .env
#
# Compose does NOT run command substitution when it reads this file. A literal
# $(openssl rand -hex 24) written below would become the token, verbatim.

VSCODE_PORT=3000
DESOLATE_PORT_MIN=8080
DESOLATE_PORT_MAX=8090

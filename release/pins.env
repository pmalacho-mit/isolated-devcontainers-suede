# desolate v3: every tool desolate downloads, by version and sha256, per architecture.
# Sourced by bash (image/provision.sh, cli.sh) and parsed by host/pins.ts: KEY=value lines only.
# A tool with no checksum here is refused, not fetched unverified (P6).
# Values marked "from v2" were verified when v2 pinned them (release/vscode-image/Dockerfile).

UBUNTU_SUITE=noble

# from v2
NODE_VERSION=24.18.0
NODE_SHA256_arm64=58c9520501f6ae2b52d5b210444e24b9d0c029a58c5011b797bc1fe7105886f6
NODE_SHA256_x64=55aa7153f9d88f28d765fcdad5ae6945b5c0f98a36881703817e4c450fa76742

# from v2. Held at 1.116: https://github.com/VSCodium/vscodium/issues/2927
VSCODIUM_VERSION=1.116.02821
VSCODIUM_SHA256_arm64=691ca7cf7df94ac1f9cb249af34e125db932aba162a2cd2a8e337be8c3d3dbd1
VSCODIUM_SHA256_x64=72e59e9946e48278e4b407ca0ee6a21cbb13d6f04855e0989f6d879953d93c07

# from v2. By commit, not tag: a tag can be moved.
GIT_SUBREPO_VERSION=0.4.9
GIT_SUBREPO_COMMIT=ea108868fe0998c912c411830bfc50dc259cc635

# from v2
DEVCONTAINERS_CLI_VERSION=0.88.0
MITMPROXY_VERSION=11.0.2

# suede's own scripts, for `desolate upstream` (section 5.5). By commit.
# EMPTY until a person pins it: `desolate upstream` refuses while it is.
SUEDE_COMMIT=

[Unit]
Description=desolate-proxy CA certificate publisher (cert only, never the key)
After=desolate-proxy.service
Requires=desolate-proxy.service

[Service]
User=desolate-proxy
Group=desolate-proxy
# Wait for mitmproxy to mint its CA on first boot, then copy ONLY the public
# cert into an empty directory that the HTTP server exposes.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do \
    [ -f /var/lib/desolate-proxy/mitmproxy-ca-cert.pem ] && break; sleep 1; done; \
    install -d -m 0755 /var/lib/desolate-proxy/public && \
    install -m 0644 /var/lib/desolate-proxy/mitmproxy-ca-cert.pem /var/lib/desolate-proxy/public/ca.pem && \
    install -m 0755 /opt/desolate-proxy/install-ca.sh /var/lib/desolate-proxy/public/install-ca.sh'
ExecStart=/usr/bin/python3 -m http.server 18081 --directory /var/lib/desolate-proxy/public
Restart=always
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/desolate-proxy
ProtectHome=yes

[Install]
WantedBy=multi-user.target

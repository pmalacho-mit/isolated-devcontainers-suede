#!/bin/sh
# desolate-work -- talk to the rest of this project's factory, over its .git.
#
#   /desolate-ca/desolate-work say <type> <body>      status | blocked | ask | answer | done
#   /desolate-ca/desolate-work ask <target> <body>    a question, to main or a worktree
#   /desolate-ca/desolate-work answer <sha> <body>    a reply to that message, to its writer
#   /desolate-ca/desolate-work done <body>            finished: tells main
#   /desolate-ca/desolate-work request open <worktree> --branch <b> [--from-ref r] [--item i] [--title t] [--brief b]
#   /desolate-ca/desolate-work request close|push <worktree>
#   /desolate-ca/desolate-work inbox                  what was said to you (or to everyone)
#   /desolate-ca/desolate-work log [--target t] [--type t]   everything, newest first
#
# How it works. Every participant owns ONE ref and only appends to it -- yours
# is refs/desolate/agents/<you>/outbox, where <you> is `main` for the project's
# own tree and the worktree's name otherwise ($DESOLATE_TARGET, which desolate
# sets). A message is one commit holding one file, message.json, with subject
# `<type>: <first line>`, so `git log` across the refs is the conversation.
# Written with plumbing only: no hook runs, nothing is checked out, the index is
# untouched, and update-ref's compare-and-swap means a racing write retries
# rather than loses a message. Nothing here pushes: refs/desolate/* stay local.
#
# Pushing a branch and merging are not yours to do. Ask with `done`, or
# `request push`, and a human -- or the policy they committed -- decides.
set -eu
LC_ALL=C
export LC_ALL

die() { echo "desolate-work: $*" >&2; exit 1; }
g() { git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"; }

command -v git >/dev/null 2>&1 || die "no git here"
g rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

# A worktree name as projects.ts spells one: a single segment, starting
# alphanumeric. Or `main`, or the human's `@human`.
is_target() {
  case "$1" in
    @human) return 0 ;;
    ""|*[!A-Za-z0-9._-]*) return 1 ;;
    [A-Za-z0-9]*) [ "${#1}" -le 64 ] ;;
    *) return 1 ;;
  esac
}

me() {
  t=${DESOLATE_TARGET:-}
  if [ -z "$t" ]; then
    top=$(g rev-parse --show-toplevel)
    case "$top" in
      */.worktrees/*) t=${top##*/.worktrees/}; t=${t%%/*} ;;
      *) t=main ;;
    esac
  fi
  is_target "$t" || die "'$t' is not a target this factory knows (DESOLATE_TARGET)"
  printf '%s' "$t"
}

# One JSON string, exactly: backslash, quote, control characters and newlines
# escaped; anything else (UTF-8 included) passed through as itself. The "." is
# a sentinel, so a trailing newline in the input survives the trip through awk.
json_str() {
  printf '%s.' "$1" | awk '
    BEGIN { ORS = ""; for (i = 1; i < 32; i++) ctl[sprintf("%c", i)] = sprintf("\\u%04x", i)
            ctl["\t"] = "\\t"; ctl["\r"] = "\\r"; printf "\"" }
    function esc(s,   out, i, c) {
      out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\\") out = out "\\\\"
        else if (c == "\"") out = out "\\\""
        else if (c in ctl) out = out ctl[c]
        else out = out c
      }
      return out
    }
    NR > 1 { print esc(prev) "\\n" }
    { prev = $0 }
    END { sub(/\.$/, "", prev); print esc(prev) "\"" }'
}
json_or_null() { if [ -n "$1" ]; then json_str "$1"; else printf 'null'; fi; }
json_list() {   # a comma-separated list, as a JSON array of strings
  printf '['; first=1; old_ifs=$IFS; IFS=,
  for x in $1; do [ -n "$first" ] || printf ','; first=""; json_str "$x"; done
  IFS=$old_ifs; printf ']'
}

zero_oid() {
  case "$(g rev-parse --show-object-format 2>/dev/null || echo sha1)" in
    sha256) printf '%064d' 0 ;;
    *) printf '%040d' 0 ;;
  esac
}

# Append one message (its JSON) to a ref, as `writer`. Prints the new commit.
# create-only: the ref must not exist yet (a request is written once).
append() {
  ref=$1 writer=$2 json=$3 subject=$4 mode=${5:-append}
  case "$writer" in @*) email=${writer#@} ;; *) email=$writer ;; esac
  GIT_AUTHOR_NAME="desolate/$writer" GIT_AUTHOR_EMAIL="$email@desolate.invalid"
  GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
  export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
  blob=$(printf '%s' "$json" | g hash-object -w --stdin)
  tree=$(printf '100644 blob %s\tmessage.json\n' "$blob" | g mktree)
  attempt=0
  while [ "$attempt" -lt 5 ]; do
    attempt=$((attempt + 1))
    old=$(g rev-parse -q --verify "$ref^{commit}" 2>/dev/null || true)
    if [ -n "$old" ]; then
      [ "$mode" = append ] || die "$ref exists already; a request is written once"
      new=$(printf '%s\n' "$subject" | g commit-tree "$tree" -p "$old")
    else
      new=$(printf '%s\n' "$subject" | g commit-tree "$tree")
      old=$(zero_oid)
    fi
    if g update-ref -m "desolate-work $mode" "$ref" "$new" "$old" 2>/dev/null; then
      printf '%s\n' "$new"
      return 0
    fi
  done
  die "could not append to $ref: another writer kept winning"
}

subject_of() {   # <type> <body>: `<type>: <first line>`, at most 200 characters
  first=$(printf '%s\n' "$2" | head -n 1 | cut -c1-200)
  printf '%s: %s' "$1" "$first"
}

head_or_null() { h=$(g rev-parse -q --verify HEAD 2>/dev/null || true); json_or_null "$h"; }

say() {   # <type> <body> [<to list>] [<reply_to>] [<item>]
  type=$1 body=$2 to=${3:-*} reply=${4:-} item=${5:-}
  case "$type" in status|ask|answer|done|blocked) ;; *) die "'$type' is not a message type (status, ask, answer, done, blocked)" ;; esac
  old_ifs=$IFS; IFS=,
  for t in $to; do [ "$t" = "*" ] || is_target "$t" || die "'$t' is not a target"; done
  IFS=$old_ifs
  self=$(me)
  json=$(printf '{"v":1,"from":%s,"to":%s,"type":%s,"body":%s,"item":%s,"commit":%s,"reply_to":%s}' \
    "$(json_str "$self")" "$(json_list "$to")" "$(json_str "$type")" "$(json_str "$body")" \
    "$(json_or_null "$item")" "$(head_or_null)" "$(json_or_null "$reply")")
  append "refs/desolate/agents/$self/outbox" "$self" "$json" "$(subject_of "$type" "$body")"
}

# Crockford base32: ten characters of milliseconds, sixteen of /dev/urandom.
ulid() {
  ms=$(date +%s%3N 2>/dev/null)
  case "$ms" in *N|"") ms=$(( $(date +%s) * 1000 )) ;; esac
  rand=$(od -An -N16 -tu1 /dev/urandom | tr -s ' \n' ' ')
  awk -v t="$ms" -v r="$rand" 'BEGIN {
    a = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"; s = ""
    for (i = 0; i < 10; i++) { s = substr(a, t % 32 + 1, 1) s; t = int(t / 32) }
    n = split(r, b, " "); for (i = 1; i <= n; i++) if (b[i] != "") s = s substr(a, b[i] % 32 + 1, 1)
    print s }'
}

request() {   # <action> <worktree> [flags]
  action=${1:-} worktree=${2:-}
  case "$action" in open|close|push) ;; *) die "usage: request open|close|push <worktree> ..." ;; esac
  is_target "$worktree" && [ "$worktree" != main ] && [ "$worktree" != @human ] \
    || die "'$worktree' is not a worktree name"
  shift 2
  branch="" from_ref="" item="" title="" brief=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) branch=${2:?--branch takes a name}; shift 2 ;;
      --from-ref) from_ref=${2:?--from-ref takes a ref}; shift 2 ;;
      --item) item=${2:?--item takes <adapter>:<id>}; shift 2 ;;
      --title) title=${2:?--title takes text}; shift 2 ;;
      --brief) brief=${2:?--brief takes text}; shift 2 ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  [ "$action" != open ] || [ -n "$branch" ] || die "request open needs --branch"
  [ -z "$branch" ] || g check-ref-format --branch "$branch" >/dev/null 2>&1 || die "'$branch' is not a branch name"
  self=$(me)
  id=$(ulid)
  json=$(printf '{"v":1,"from":%s,"to":["*"],"type":"request","body":%s,"item":%s,"commit":null,"reply_to":null,"action":%s,"worktree":%s,"branch":%s,"from_ref":%s,"title":%s,"brief":%s}' \
    "$(json_str "$self")" "$(json_str "$action $worktree${title:+: $title}")" "$(json_or_null "$item")" \
    "$(json_str "$action")" "$(json_str "$worktree")" "$(json_or_null "$branch")" "$(json_or_null "$from_ref")" \
    "$(json_or_null "$title")" "$(json_or_null "$brief")")
  append "refs/desolate/requests/$id" "$self" "$json" "$(subject_of request "$action $worktree")" create >/dev/null
  echo "refs/desolate/requests/$id"
}

# Every message on these refs, newest first: <sha> <date> <writer> <subject>.
messages() {
  for ref in $(g for-each-ref --format='%(refname)' "$@"); do
    g log --format='%H%x09%cI%x09%an%x09%s' "$ref"
  done | sort -t "$(printf '\t')" -k2,2r
}

case "${1:-}" in
  say)     [ $# -ge 3 ] || die "usage: say <type> <body>"
           say "$2" "$3" >/dev/null ;;
  ask)     [ $# -ge 3 ] || die "usage: ask <target> <body>"
           say ask "$3" "$2" >/dev/null ;;
  answer)  [ $# -ge 3 ] || die "usage: answer <sha> <body>"
           sha=$(g rev-parse -q --verify "$2^{commit}" 2>/dev/null) || die "no message $2"
           to=$(g log -1 --format=%an "$sha"); to=${to#desolate/}
           say answer "$3" "$to" "$sha" >/dev/null ;;
  done)    [ $# -ge 2 ] || die "usage: done <body>"
           say done "$2" main >/dev/null ;;
  request) shift; request "$@" ;;
  inbox)   self=$(me)
           messages refs/desolate/agents refs/desolate/desolate refs/desolate/forge \
           | while IFS="$(printf '\t')" read -r sha date writer subject; do
               [ "$writer" != "desolate/$self" ] || continue
               to=$(g cat-file -p "$sha:message.json" 2>/dev/null | grep -o '"to":\[[^]]*\]' || true)
               case "$to" in *"\"$self\""*|*'"*"'*) printf '%.12s  %s  %-24s %s\n' "$sha" "$date" "$writer" "$subject" ;; esac
             done ;;
  log)     shift; target="" type=""
           while [ $# -gt 0 ]; do
             case "$1" in --target) target=$2; shift 2 ;; --type) type=$2; shift 2 ;; *) die "unknown option '$1'" ;; esac
           done
           messages refs/desolate \
           | while IFS="$(printf '\t')" read -r sha date writer subject; do
               [ -z "$target" ] || [ "$writer" = "desolate/$target" ] || continue
               [ -z "$type" ] || case "$subject" in "$type: "*) ;; *) continue ;; esac
               printf '%.12s  %s  %-24s %s\n' "$sha" "$date" "$writer" "$subject"
             done ;;
  *)       sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

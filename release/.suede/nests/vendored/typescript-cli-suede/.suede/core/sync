#!/usr/bin/env bash
# .suede/core/sync — ships INSIDE a suede dependency:
#     <repo>/<dependency>/.suede/core/sync
#
# Running it pulls THIS dependency's latest `release` commits into your repo:
#     ./<dependency>/.suede/core/sync            (if executable)
#     bash <dependency>/.suede/core/sync
#
# It takes no target - the dependency is the one containing this script, the
# same way `upstream` works. Anything you do pass is handed to
# `git subrepo pull`, so `sync --force` and friends behave as git-subrepo
# documents them.
#
# Two things it does that a bare `git subrepo pull` will not:
#   * runs from the repository root with a root-relative path, so the caller's
#     cwd does not matter;
#   * resolves symlinks to the real folder first - `git subrepo pull` on a
#     symlink path fails outright, and the edge entries between dependencies
#     are symlinks by default.
#
# `git subrepo pull` also requires a clean working tree, while install does
# not. If you have just installed, commit before syncing.

set -euo pipefail

usage() { grep '^#' "$0" | grep -v '^#!/' | sed 's/^# \?//'; exit 0; }
[[ "${1-}" == "-h" || "${1-}" == "--help" ]] && usage

die() { printf 'sync: %s\n' "$*" >&2; exit 1; }

command -v git >/dev/null 2>&1 || die "git not found"

# git-subrepo is a git subcommand found on PATH, but an environment can have it
# installed without it being reachable - a devcontainer feature or a login
# shell profile that a non-interactive script never sourced. GIT_SUBREPO_ROOT
# is the marker those installs leave behind, and its `.rc` is what puts the
# command in scope.
ensure_git_subrepo() {
  git subrepo --version >/dev/null 2>&1 && return 0
  [[ -n "${GIT_SUBREPO_ROOT-}" && -f "${GIT_SUBREPO_ROOT-}/.rc" ]] || return 1
  # `.rc` ends by sourcing a completion script written for an interactive
  # shell, so strictness comes off for the duration and the outcome is checked
  # rather than trusted.
  set +eu
  # shellcheck disable=SC1091
  source "$GIT_SUBREPO_ROOT/.rc"
  set -eu
  git subrepo --version >/dev/null 2>&1
}

ensure_git_subrepo \
  || die "git-subrepo is not installed (https://github.com/ingydotnet/git-subrepo)"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" >/dev/null 2>&1 && pwd -P)" \
  || die "cannot resolve script location"

# The dependency root is exactly two levels up (<dep>/.suede/core/sync), and
# `pwd -P` above has already resolved whatever symlink the caller came through.
DEP_DIR="$(cd "$SELF_DIR/../.." >/dev/null 2>&1 && pwd -P)" \
  || die "cannot resolve dependency root above $SELF_DIR"
[[ -f "$DEP_DIR/.gitrepo" ]] \
  || die "no .gitrepo at $DEP_DIR - is this inside an installed suede dependency?"

ROOT="$(cd "$DEP_DIR" && git rev-parse --show-toplevel 2>/dev/null)" \
  || die "$DEP_DIR is not inside a git repository"
ROOT="$(cd "$ROOT" && pwd -P)"
[[ "$DEP_DIR" != "$ROOT" ]] \
  || die "the dependency must live inside the repo, not at its root"

cd "$ROOT"
git subrepo pull "${DEP_DIR#"$ROOT"/}" "$@"

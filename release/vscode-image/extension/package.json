{
  "name": "desolate",
  "displayName": "desolate",
  "description": "Projects, their worktrees and dinds, and each one's status, in the outer editor. Built in; talks only to the commands this editor already has.",
  "version": "0.1.0",
  "publisher": "desolate",
  "license": "MIT",
  "engines": {
    "vscode": "^1.116.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "desolate",
          "title": "desolate",
          "icon": "media/desolate.svg"
        }
      ]
    },
    "views": {
      "desolate": [
        {
          "id": "desolate.projects",
          "name": "Projects"
        },
        {
          "id": "desolate.dinds",
          "name": "Dinds"
        }
      ]
    },
    "commands": [
      {
        "command": "desolate.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "desolate.start",
        "title": "Start",
        "icon": "$(play)"
      },
      {
        "command": "desolate.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "desolate.openPort",
        "title": "Open",
        "icon": "$(link-external)"
      },
      {
        "command": "desolate.rebuild",
        "title": "Rebuild\u2026",
        "icon": "$(debug-restart)"
      },
      {
        "command": "desolate.pull",
        "title": "Pull",
        "icon": "$(repo-pull)"
      },
      {
        "command": "desolate.push",
        "title": "Push\u2026",
        "icon": "$(repo-push)"
      },
      {
        "command": "desolate.openEditor",
        "title": "Open editor",
        "icon": "$(link-external)"
      },
      {
        "command": "desolate.copyUrl",
        "title": "Copy editor URL"
      },
      {
        "command": "desolate.worktreeAdd",
        "title": "Add worktree\u2026"
      },
      {
        "command": "desolate.worktreeRemove",
        "title": "Remove worktree\u2026"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "desolate.refresh",
          "when": "view =~ /^desolate\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "desolate.openPort",
          "when": "viewItem == port",
          "group": "inline"
        },
        {
          "command": "desolate.start",
          "when": "viewItem =~ /^(project|worktree)\\.stopped$/",
          "group": "inline"
        },
        {
          "command": "desolate.openEditor",
          "when": "viewItem =~ /^(project|worktree)\\.running$/",
          "group": "inline"
        },
        {
          "command": "desolate.stop",
          "when": "viewItem =~ /^(project|worktree)\\.running$/",
          "group": "inline"
        },
        {
          "command": "desolate.copyUrl",
          "when": "viewItem =~ /^(project|worktree)\\.running$/"
        },
        {
          "command": "desolate.pull",
          "when": "viewItem =~ /^(project|worktree)\\./",
          "group": "inline"
        },
        {
          "command": "desolate.push",
          "when": "viewItem =~ /^(project|worktree)\\./",
          "group": "inline"
        },
        {
          "command": "desolate.rebuild",
          "when": "viewItem =~ /^(project|worktree)\\./",
          "group": "inline"
        },
        {
          "command": "desolate.worktreeAdd",
          "when": "viewItem =~ /^project\\./"
        },
        {
          "command": "desolate.worktreeRemove",
          "when": "viewItem == worktree.stopped"
        }
      ],
      "commandPalette": [
        {
          "command": "desolate.start",
          "when": "false"
        },
        {
          "command": "desolate.stop",
          "when": "false"
        },
        {
          "command": "desolate.rebuild",
          "when": "false"
        },
        {
          "command": "desolate.openEditor",
          "when": "false"
        },
        {
          "command": "desolate.copyUrl",
          "when": "false"
        },
        {
          "command": "desolate.worktreeAdd",
          "when": "false"
        },
        {
          "command": "desolate.worktreeRemove",
          "when": "false"
        },
        {
          "command": "desolate.openPort",
          "when": "false"
        },
        {
          "command": "desolate.pull",
          "when": "false"
        },
        {
          "command": "desolate.push",
          "when": "false"
        }
      ]
    }
  }
}
